# All server-only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
# Legacy service_role key or the newer sb_secret_... key
SUPABASE_SERVICE_ROLE_KEY=
# Single-user passcode (digits recommended — the login screen is a keypad)
APP_PASSCODE=
# Long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=
APP_TIMEZONE=Asia/Colombo
